# Google Gemini API Key (Get free from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail credentials for sending emails
# Note: GMAIL_APP_PASSWORD must be a 16-character App Password, NOT your regular Gmail password.
# Generate it at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Target Instagram profile username (without @)
INSTAGRAM_USERNAME=pixell.poet

# Recipient Email ID (ABP Ananda Nadia Editorial)
RECIPIENT_EMAIL=edit.nadia@abp.in

# Optional: If Instagram requires authentication on GitHub Actions runners,
# you can provide an Instagram session file base64 or login credentials.
# INSTAGRAM_SESSION_BASE64=
